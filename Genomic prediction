#run semi parametric RKHS model
#Pheno and geno data
X <- genot.ok
Y <- pheno
#run the model with 100 repetition
# Initialize lists for storing overall results
PA_rkhs_all <- numeric(100)  
n <- nrow(X)

for (iteration in 1:100) {
  # Create indices for training and validation
  set.seed(iteration)  # For reproducibility
  indices <- sample(n)  # generate indices
  train_indices <- indices[1:(4*n/5)]
  val_indices <- setdiff(1:n, train_indices)  # The rest of the indices for validation
  
  # Subset the data
  X_train <- X[train_indices, ]
  X_val <- X[val_indices, ]
  Y_train <- Y[train_indices]
  Y_val <- Y[val_indices]
  
  #combine the X geno data
  X_ordered <- rbind(X_train, X_val)
  # Compute D and then K for training data
  p <- ncol(X_ordered)
  D <- (as.matrix(dist(X_ordered, method="euclidean"))^2) / p
  h <- round(1 / median(D[row(D) > col(D)]), 2)
  h <- h * c(1/5, 1, 5)
  
  K1 <- exp(-h[1] * D)
  K2 <- exp(-h[2] * D)
  K3 <- exp(-h[3] * D)
  K3[1:5,1:5]
  # Kernel averaging
  ETA <- list(
    list(K = K1, model = "RKHS"),
    list(K = K2, model = "RKHS"),
    list(K = K3, model = "RKHS")
  )
  # Combine training and validation phenotypes for BGLR
  Ytr_FFB2 <- c(Y_train, rep(NA, length(Y_val)))
  #Ytr_FFB2 <- Y_train
  
  # Multi-kernel RKHS 
  print(paste("RKHS iteration", iteration))
  
  # Initialize lists for storing results
  y_pred_VAL_rkhs_list <- list()
  PA_rkhs <- vector()
  
  # Train and validate the model
  
    fmRKHS <- BGLR(y = Ytr_FFB2, ETA = ETA, nIter = 10000, burnIn = 5000, 
                   thin = 10, verbose = FALSE)
    
    y_pred_VAL_rkhs <- fmRKHS$yHat[(length(Y_train) + 1):length(fmRKHS$yHat)]
    
    y_pred_VAL_rkhs_list[[iteration]] <- y_pred_VAL_rkhs
    PA_rkhs <- cor(y_pred_VAL_rkhs, Y_val)
  
    # Store the predictive accuracy for this iteration
    PA_rkhs_all[iteration] <- PA_rkhs

    # Optionally print progress
    print(paste("Iteration:", iteration, "PA:", PA_rkhs))
}

