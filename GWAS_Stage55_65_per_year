unique_correlations <- list()
calculate_correlations <- function(data, year) {
  # Filter data for the given year
  data_year <- data %>% 
    filter(year == !!year) %>%
    ungroup()  # Remove any existing grouping
  
  # Select columns containing stage values
  stages_data <- data_year %>% select(starts_with("mean_Stage"))
  # Calculate correlation matrix
  correlation_matrix <- cor(stages_data, use = "pairwise.complete.obs", method = "pearson")
  correlation_matrix <- round(correlation_matrix, digits = 2)
  
  # Convert the correlation matrix to a tidy format
  correlation_tidy <- as.data.frame(as.table(correlation_matrix))
  colnames(correlation_tidy) <- c("Stage1", "Stage2", "Correlation")
  
  correlation_tidy <-  correlation_tidy %>%
    filter(Stage1 != Stage2)
  correlation_tidy <- correlation_tidy %>%
    mutate(Stage1 = gsub("mean_", "", Stage1),  # Removing "mean_" from Stage1 column
           Stage2 = gsub("mean_", "", Stage2))  # Removing "mean_" from Stage2 column
  # Identify duplicates with reversed order of stages
  duplicates <- correlation_tidy[duplicated(paste(pmin(correlation_tidy$Stage1, 
                                                       correlation_tidy$Stage2), pmax(correlation_tidy$Stage1, correlation_tidy$Stage2))), ]
  
  # Remove duplicates
  unique_correlations <- correlation_tidy[!duplicated(paste(pmin(correlation_tidy$Stage1, 
                                                                 correlation_tidy$Stage2), pmax(correlation_tidy$Stage1, correlation_tidy$Stage2))), ]
  
  unique_correlations$Year <- year
  
  return(unique_correlations)
}
