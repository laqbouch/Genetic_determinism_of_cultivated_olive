# Initialize a list to store heritability results
heritability_results <- list()
subset_data <- function(data, column_name) {
  data[, c("Name_on_cluster", "year", column_name)]
}
# Loop through each stage
for (stage in stages) {
  # Subset data for the current year and stage
  stage_data <- subset_data(pheno_all, stage)
  # Remove rows with NA values for the current year and stage
  stage_data <- na.omit(stage_data)
  stage_data$year <- as.factor(stage_data$year)
  # Fit linear mixed model
  formula <- as.formula(paste(stage, "~ (1 | Name_on_cluster) + (1 | Name_on_cluster:year) +year"))
  model <- lmer(formula, data = stage_data)
  tabvar=as.data.frame(VarCorr(model))
  varinter = tabvar[1,4]
  varGeno = tabvar[2,4]
  varRes = tabvar[3,4]
  H2 = varGeno / (varGeno + varinter/7 + varRes/(mean(table(pheno_all$Name_on_cluster,
                                                            pheno_all$year))*7))
  H2
  # Store the heritability result
  heritability_results[[stage]] <- H2
}

