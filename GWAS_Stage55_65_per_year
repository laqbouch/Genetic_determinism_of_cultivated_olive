# Fonction pour générer les Manhattan plots
generate_manhattan_plots <- function(stage, chr_data_2019, chr_data_2021, chr_num) {
  # Créer un nouveau graphique
  # Plot pour l'année 2019
  png(file = file.path(base_dir,stage, paste0("Manhat_mm4lmm_", chr_num, "_2019_2021.png")), res = 110, width = 1000, height = 400)
  
  p1 <- ggplot(chr_data_2019, aes(x = Pos, y = -log10(P))) +
    geom_point(size = 2, color = "black") +  # Définir la couleur des points en noir
    geom_hline(yintercept = -log10(1e-5), linetype = "dashed", color = "red") +
    labs(title = paste("Manhattan plot -", stage, "- Chr", chr_num, "- 2019"),
         x = "Position (bp)", y = "-log10(P-value)") +
    theme_minimal() +
    theme(legend.position = "bottom")+
    ylim(0, 10)
  
  
  # Plot pour l'année 2021
  p2 <- ggplot(chr_data_2021, aes(x = Pos, y = -log10(P))) +
    geom_point(size = 2, color = "black") +  # Définir la couleur des points en noir
    geom_hline(yintercept = -log10(1e-5), linetype = "dashed", color = "red") +
    labs(title = paste("Manhattan plot -", stage, "- Chr", chr_num, "- 2021"),
         x = "Position (bp)", y = "-log10(P-value)") +
    theme_minimal() +
    theme(legend.position = "bottom")+
    ylim(0, 10)
  
  # Combinaison des deux graphiques en une grille
  grid.arrange(p1, p2, ncol = 1)
  dev.off()
}


