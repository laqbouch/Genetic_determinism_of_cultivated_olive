stages <- c("mean_Stage_55", "mean_Stage_65")
unique_years <- c("2015", "2016","2018", "2019","2021")

# Create a base output directory if it doesn't exist
output_base <- "MM4LMM_Results"
dir.create(output_base, showWarnings = FALSE)

# Loop through each stage and year
for (stage in stages) {
  stage_dir <- file.path(output_base, stage)
  dir.create(stage_dir, showWarnings = FALSE)
  
  for (year in unique_years) {
    # Subset data for the current year and stage
    year_data <- mean_per_cluster_year[mean_per_cluster_year$year == year, c("Name_on_cluster", stage)]
    
    # Remove rows with NA values for the current year and stage
    year_data <- na.omit(year_data)
    geno_names <- year_data$Name_on_cluster
    
    # Extract phenotype and genotype data
    y <- year_data[[stage]]
    names(y) <- geno_names
    
    genot_subset <- genot.ok[year_data$Name_on_cluster, ]
    
    # Order genotype to fit phenotype
    genot_subset <- genot_subset[match(names(y), rownames(genot_subset)), ]
    
    # Create a directory for the current year results within the stage directory
    year_dir <- file.path(stage_dir, paste0("Year_", year))
    dir.create(year_dir, showWarnings = FALSE)
    
    png(file = file.path(year_dir, paste0("verif_genot_names_", year, ".png")), width = 1220, height = 675)
    plot(match(rownames(genot_subset), names(y)))
    dev.off()
    
    png(file = file.path(year_dir, paste0("verif_genot_SNP_", year, ".png")), width = 1220, height = 675)
    plot(match(map$SNP, colnames(genot_subset)))
    dev.off()
    
    # Convert genotype data to numeric
    genot_subset <- as.matrix(genot_subset)
    
    # Compute genetic relationship matrix (K)
    K <- beta.dosage(genot_subset)
    K <- make.positive.definite(K)
    
    # Run MM4LMM GWAS analysis
    mmest_K <- MMEst(Y = y, X = genot_subset, VarList = list(Additive = K, Error = diag(length(y))), Verbose = TRUE, Cofactor = NULL)
    out_test_K <- AnovaTest(mmest_K)
    
    # Print or store GWAS results for the current year
    ap(out_test_K)
    #res.mm4lmm_K <- cbind(map, P = sapply(out_test_K, function(x){x["Xeffect", "pval"]}))
    res.mm4lmm_K <- cbind(map, 
                          P = sapply(out_test_K, function(x) x["Xeffect", "pval"]),
                          SNP_effect = sapply(out_test_K, function(x) x["Xeffect", "Wald (Type III)"]))
    
    ap(res.mm4lmm_K)
    # Save results
    write.csv(res.mm4lmm_K, file = file.path(year_dir, paste0("Result_mm4lmm_p_values_", year, ".csv")), row.names = FALSE)
    
    png(file = file.path(year_dir, paste0("QQ_plot_mm4lmm_", stage, "_", year, ".png")))
    qq(res.mm4lmm_K$P, main = paste0("Q-Q_plot_GWAS_MM4LMM_", stage, "_", year))
    dev.off()
    
    # QQ plot with real values of p values
    u <- runif(nrow(res.mm4lmm_K), 0, 1)
    png(file = file.path(year_dir, paste0("QQ_p_values_mm4lmm_", stage, "_", year, ".png")))
    qqplot(u, res.mm4lmm_K$P, main = paste0("QQ_p_values_mm4lmm_", stage, "_", year))
    dev.off()
    
    # FDR correction
    p_values <- res.mm4lmm_K$P
    p_adjusted <- p.adjust(p_values, method = "fdr")
    ap(p_adjusted)
    p_adjusted_coor <- cbind(res.mm4lmm_K$SNP, res.mm4lmm_K$P, p_adjusted, res.mm4lmm_K$SNP_effect)
    ap(p_adjusted_coor)
    colnames(p_adjusted_coor) <- c("SNP", "P", "p_adjusted", "SNP_effect")
    p_adjusted_coor <- as.data.frame(p_adjusted_coor)
    dim(p_adjusted_coor)
    
    # Extract significant SNPs
    signifSNPs <- p_adjusted_coor[p_adjusted_coor$p_adjusted < 0.05, ]
    signifSNPs
    dim(signifSNPs)
    write.csv(signifSNPs, file = file.path(year_dir, paste0("Result_mm4lmm_K_sig_SNP_FDR_5_", year, ".csv")), row.names = FALSE)
    
    # Export all SNPs
    write.csv(p_adjusted_coor, file = file.path(year_dir, paste0("Result_mm4lmm_K_sig_SNP_FDR_", year, ".csv")), row.names = FALSE)
    
    # Convert P and p_adjusted columns to numeric if they are not already
    signifSNPs$P <- as.numeric(signifSNPs$P)
    signifSNPs$p_adjusted <- as.numeric(signifSNPs$p_adjusted)
    
    # Sort the data frame by p_adjusted in descending order
    signifSNPs_ordered <- signifSNPs[order(-signifSNPs$P), ]
    
    # Get the SNP with the highest p_adjusted
    thresh <- signifSNPs_ordered[1, ]
    
    # Access the p_adjusted value of the most significant SNP
    thresh <- thresh$P
    res.mm4lmm_K_chr <- subset(res.mm4lmm_K, Chr %in% 1:23)
    tail(res.mm4lmm_K_chr)
    
    if (!is.na(thresh)) {
      png(file = file.path(year_dir, paste0("Manhat_mm4lmm_", stage, "_FDR5_CHR_", year, ".png")), res = 110, width = 1000, height = 400)
      manhattan(res.mm4lmm_K_chr, chr = "Chr", bp = "Pos", p = "P",
                suggestiveline = -log10(thresh),
                col = c("navyblue", "orangered2"), 
                ylim = c(0, 10),
                genomewideline = -log10(thresh),
                main = paste0(stage, "_MM4LMM_", year),
                annotatePval = 0.00001,
                cex.main = 0.8)
      dev.off()
    }
      }
}

